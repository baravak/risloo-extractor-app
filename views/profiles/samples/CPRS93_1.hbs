{{#> layout}}
<defs>
    <linearGradient id="cprs-bar" gradientTransform="rotate(90)">
        <stop offset="0%" stop-color="#0284C7" />
        <stop offset="100%" stop-color="#7DD3FC" />
    </linearGradient>
</defs>
{{#if valid}}
<g>
    <text x="431.5" y="24" font-size="16" font-weight="600" fill="#334155" text-anchor="middle">عوامل کلاسیک</text>
    {{!-- Row above the bars: item mean, two decimals --}}
    <text x="108" y="78" dy=".33em" font-size="12" font-weight="400" fill="#94A3B8" text-anchor="start">میانگین</text>
    {{#each items as |item|}}
        <rect x="{{math item.x '-' 4}}" y="69" width="48" height="18" fill="#0284C7" rx="4"/>
        <text x="{{math item.x '+' 20}}" y="78" dy=".33em" font-size="12" font-weight="400" fill="#ffffff" text-anchor="middle">{{item.mean}}</text>
    {{/each}}
    {{!-- Even T axis; gridline per tick, one solid line at T 50, no bands --}}
    {{#each ticks as |tick|}}
        <line x1="120" y1="{{tick.y}}" x2="800" y2="{{tick.y}}" stroke="#E2E8F0" stroke-linecap="round" stroke-dasharray="6 6"/>
        <text x="108" y="{{tick.y}}" dy=".33em" font-size="12" font-weight="400" fill="#94A3B8" text-anchor="start">{{tick.value}}</text>
    {{/each}}
    {{#each items as |item|}}
        <g transform="translate({{item.x}}, 120)">
            {{bar 40 400 (object tl=6 tr=6 bl=0 br=0) (toRad 0) fill='#F1F5F9'}}
        </g>
    {{/each}}
    <line x1="120" y1="{{fifty}}" x2="800" y2="{{fifty}}" stroke="#94A3B8" stroke-width="1"/>
    <text x="108" y="{{fifty}}" dy=".33em" font-size="12" font-weight="600" fill="#64748B" text-anchor="start">50</text>
    {{#each items as |item|}}
        <g transform="translate({{item.x}}, 120)">
            {{bar 40 item.height (object tl=6 tr=6 bl=0 br=0) (toRad 0) transform=item.transform fill='url(#cprs-bar)'}}
            <text x="20" y="{{item.tY}}" dy=".77em" font-size="12" font-weight="600" fill="{{item.tFill}}" text-anchor="middle">{{item.t}}</text>
            {{#each item.label as |line lineIndex|}}
                <text x="20" y="{{math 412 '+' (math 16 '*' lineIndex)}}" dy=".77em" font-size="12" font-weight="400" fill="#475569" text-anchor="middle">{{line}}</text>
            {{/each}}
        </g>
    {{/each}}
</g>
{{else}}
{{! ===================== No result (all-or-nothing), centred on the Chart ===================== }}
<g transform="translate(0, -10.5)">
    <rect x="181.5" y="237.5" width="500" height="199" rx="12" fill="#F8FAFC" stroke="#E2E8F0"/>
    <circle cx="431.5" cy="298" r="17" fill="none" stroke="#64748B" stroke-width="2"/>
    <line x1="431.5" y1="289" x2="431.5" y2="301" stroke="#64748B" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="431.5" cy="307.5" r="1.6" fill="#64748B"/>
    <text x="431.5" y="362" text-anchor="middle" font-size="17" font-weight="600" fill="#1E293B">نمره تولید نشد</text>
</g>
{{/if}}
{{/layout}}
