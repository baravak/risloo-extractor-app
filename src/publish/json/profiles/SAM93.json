    "description": "## دستور اجرای آزمون\n\nلطفا هر یک از جملات زیر را به دقت بخوانید و مشخص کنید که هر جمله تا چه اندازه در مورد شما صدق می‌کند و یکی از پنج گزینه را انتخاب کنید",
    "items": [
        {
            "type": "text",
            "text": "من تردید دارم که آیا دیگران واقعا مرا دوست دارند یا نه.",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "4"
        },
        {
            "type": "text",
            "text": "من دائما مراقبم که از دیدگاه دیگران چگونه به نظر می‌آیم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "3"
        },
        {
            "type": "text",
            "text": "من احساس می‌کنم بین بخش‌های متفاوت شخصیتم گسیخته می‌شوم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "1"
        },
        {
            "type": "text",
            "text": "می‌ترسم که دست به کاری وحشتناک بزنم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "5"
        },
        {
            "type": "text",
            "text": "من راجع به ارزش خود به عنوان یک انسان فکر می‌کنم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "3"
        },
        {
            "type": "text",
            "text": "من دائما در مورد اینکه دیگران چه درکی از من دارند، گوش بزنگم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "3"
        },
        {
            "type": "text",
            "text": "من احساس می‌کنم پر از تناقض هستم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "2"
        },
        {
            "type": "text",
            "text": "من در مورد اینکه دیگران تا چه اندازه می‌خواهند به من نزدیک شوند، تردید دارم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
            },
            "user_answered": "3"
        },
        {
            "type": "text",
            "text": "من تمایل دارم در مورد خودم در قالب «خوب» یا «بد» فکر کنم. ",
            "answer": {
                "type": "optional",
                "options": [
                    "اصلا",
                    "کم",
                    "تا حدی",
                    "زیاد",
                    "خیلی زیاد"
                ]
