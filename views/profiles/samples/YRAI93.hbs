{{#> layout}}

  <g transform="translate({{spec.profile.padding.x}}, {{spec.profile.padding.y}})">
  {{#each items as |item|}}

    {{! ===================== Component name, on the left of its bar ===================== }}
    <text x="{{../titleRight}}" y="{{item.baseline}}" text-anchor="start" font-size="13" fill="#475569">{{item.title}}</text>

    {{! ===================== Track (unfilled part) and the filled part, from 0 to 100 ===================== }}
    <g transform="translate({{../bar.x}}, {{item.top}})">
      {{bar ../bar.length ../bar.height (object tl=0 bl=0 tr=2 br=2) (toRad 0) fill=../color.track}}
      {{#if item.width}}{{bar item.width ../bar.height (object tl=0 bl=0 tr=2 br=2) (toRad 0) fill=../color.fill}}{{/if}}
    </g>

    {{! ===================== Beside the bar: percent, then "raw از max"; nothing when not produced ===================== }}
    {{#if item.produced}}
      <text x="{{../pctX}}" y="{{item.baseline}}" text-anchor="start" direction="ltr" unicode-bidi="embed" font-size="13" font-weight="500" fill="{{../color.fill}}">٪ {{item.pct}}</text>
      <text x="{{../rawX}}" y="{{item.baseline}}" text-anchor="end" font-size="12" fill="#64748B"><tspan font-size="13" font-weight="500" fill="#334155">{{item.mark}}</tspan> از {{item.max}}</text>
    {{/if}}

  {{/each}}
  </g>

{{/layout}}
