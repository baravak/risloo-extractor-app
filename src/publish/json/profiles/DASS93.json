        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "1"
    },
    {
      "type": "text",
      "text": "خدا را پریشان و سر در گم احساس می‌کنم.",
