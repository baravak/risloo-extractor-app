{{#> layout}}

  <g transform="translate({{spec.profile.padding.x}}, {{spec.profile.padding.y}})">

  {{#if valid}}

    {{! ===================== Three styles, three separate 12–60 lines ===================== }}
    {{! Fixed order, one neutral hue, no zone, no threshold; nothing marks or ranks the highest score. }}
    <text x="843" y="24" text-anchor="start" font-size="16" font-weight="600" fill="#1E293B">نمره‌ها</text>
    <text x="843" y="50" text-anchor="start" font-size="12.5" fill="#64748B">دامنهٔ هر نمره 12 تا 60</text>

    {{#each styles as |item|}}
      <text x="843" y="{{math item.y '+' 5}}" text-anchor="start" font-size="14" font-weight="600" fill="#334155">{{item.title}}</text>
      <text x="{{math item.right '+' 40}}" y="{{math item.y '+' 5}}" text-anchor="middle" font-size="14" font-weight="700" fill="#1E293B">{{item.mark}}</text>

      <line x1="{{item.left}}" y1="{{item.y}}" x2="{{item.right}}" y2="{{item.y}}" stroke="#CBD5E1" stroke-width="4" stroke-linecap="round"/>
      <line x1="{{item.left}}" y1="{{math item.y '-' 7}}" x2="{{item.left}}" y2="{{math item.y '+' 7}}" stroke="#94A3B8" stroke-width="1.5"/>
      <line x1="{{item.right}}" y1="{{math item.y '-' 7}}" x2="{{item.right}}" y2="{{math item.y '+' 7}}" stroke="#94A3B8" stroke-width="1.5"/>
      <text x="{{item.left}}" y="{{math item.y '+' 24}}" text-anchor="middle" font-size="11" fill="#94A3B8">{{item.min}}</text>
      <text x="{{item.right}}" y="{{math item.y '+' 24}}" text-anchor="middle" font-size="11" fill="#94A3B8">{{item.max}}</text>

      <circle cx="{{item.x}}" cy="{{item.y}}" r="7" fill="#475569" stroke="white" stroke-width="2"/>
      <text x="{{item.x}}" y="{{math item.y '-' 14}}" text-anchor="middle" font-size="13" font-weight="700" fill="#1E293B">{{item.mark}}</text>
    {{/each}}

    {{! ===================== Interpretation and uncertainty ===================== }}
    {{! Fixed text from the science package, verbatim; the profile is read by the authorised specialist. }}
    <rect x="0.5" y="280.5" width="862" height="248" rx="8" fill="#F8FAFC" stroke="#E2E8F0"/>

    <text x="843" y="310" text-anchor="start" font-size="15" font-weight="600" fill="#1E293B">تفسیر</text>
    <text x="843" y="338" text-anchor="start" font-size="13.5" fill="#334155">نمرهٔ بالاتر در هر سبک یعنی پاسخ‌دهنده آن سبک را در حل مسائلش بیشتر گزارش کرده است.</text>
    <text x="843" y="362" text-anchor="start" font-size="13.5" fill="#334155">این نمره دربارهٔ میزان یا درستی ایمان پاسخ‌دهنده چیزی نمی‌گوید.</text>

    <text x="843" y="398" text-anchor="start" font-size="15" font-weight="600" fill="#1E293B">عدم قطعیت و محدودیت</text>
    <circle cx="840" cy="421.5" r="2" fill="#334155"/>
    <text x="831" y="426" text-anchor="start" font-size="13.5" fill="#334155">برای این نسخه هنجار ایرانی وجود ندارد.</text>
    <circle cx="840" cy="445.5" r="2" fill="#334155"/>
    <text x="831" y="450" text-anchor="start" font-size="13.5" fill="#334155">سه نمره کنار هم خوانده شوند.</text>
    <circle cx="840" cy="469.5" r="2" fill="#334155"/>
    <text x="831" y="474" text-anchor="start" font-size="13.5" fill="#334155">نمرهٔ تأخیری در جامعهٔ ایرانی معنای یکدستی ندارد.</text>
    <circle cx="840" cy="493.5" r="2" fill="#334155"/>
    <text x="831" y="498" text-anchor="start" font-size="13.5" fill="#334155">آزمون تصمیم‌یار است، نه تصمیم‌گیر قطعی.</text>

  {{else}}

    {{! ===================== No score (all-or-nothing) ===================== }}
    {{! Only the approved sentence: no number, no line, no partial score. }}
    <rect x="181.5" y="237.5" width="500" height="171" rx="12" fill="#F8FAFC" stroke="#E2E8F0"/>
    <circle cx="431.5" cy="288" r="17" fill="none" stroke="#64748B" stroke-width="2"/>
    <line x1="431.5" y1="279" x2="431.5" y2="291" stroke="#64748B" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="431.5" cy="297.5" r="1.6" fill="#64748B"/>
    <text x="431.5" y="354" text-anchor="middle" font-size="16" font-weight="600" fill="#1E293B">نمره تولید نشد: پاسخ‌نامه کامل یا معتبر نبود.</text>

  {{/if}}

  </g>

{{/layout}}
