{{#> layout}}
  <defs>
    {{! Original gradient geometry; each factor has its own fixed palette. }}
    {{#each styles as |item|}}
      <linearGradient id="prps-gauge-gradient-{{item.key}}" x1="70" y1="-69.2295" x2="-58.8284" y2="125.6012" gradientUnits="userSpaceOnUse">
        <stop stop-color="{{item.theme.accent}}"/>
        <stop offset="0.5" stop-color="{{item.theme.primary}}"/>
        <stop offset="1" stop-color="{{item.theme.primary}}"/>
      </linearGradient>
    {{/each}}
    <path id="prps-gauge-track" d="{{trackPath}}"/>
    <clipPath id="prps-gauge-clip"><use href="#prps-gauge-track"/></clipPath>
  </defs>
  <g transform="translate({{spec.profile.padding.x}}, {{spec.profile.padding.y}})" data-prps-gauges="true">
    {{#each styles as |item|}}
      <g transform="translate({{item.x}}, 0)" data-prps-style="{{item.title}}">
        <g transform="translate(70.5, 70)">
          <use href="#prps-gauge-track" fill="{{item.theme.track}}"/>
          {{#if item.fillPath}}
            <path d="{{item.fillPath}}" fill="url(#prps-gauge-gradient-{{item.key}})" clip-path="url(#prps-gauge-clip)"/>
          {{/if}}
          <text x="0.5" y="-4.16" text-anchor="middle" direction="ltr" unicode-bidi="embed" font-size="24" font-weight="600" fill="{{item.theme.primary}}">٪ {{item.pct}}</text>
          <text x="0.5" y="21.275" text-anchor="middle" direction="rtl" font-size="15" font-weight="500" fill="#64748B">{{item.mark}} از {{item.max}}</text>
          <text x="-59" y="-7.51" text-anchor="middle" direction="ltr" unicode-bidi="embed" font-size="14" font-weight="500" fill="#64748B">٪ 100</text>
          <text x="-11" y="-57.01" text-anchor="middle" direction="ltr" font-size="14" font-weight="500" fill="#64748B">0</text>
        </g>
        <text x="70.5" y="172.06" text-anchor="middle" font-size="16" font-weight="500" fill="{{item.theme.primary}}">{{item.title}}</text>
      </g>
    {{/each}}
  </g>
{{/layout}}
