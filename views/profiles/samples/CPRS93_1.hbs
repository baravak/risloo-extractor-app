{{#> layout}}
  {{#if valid}}
  <defs>
    <linearGradient id="cprs-bar" x1="0" y1="0" x2="1" y2="0">
      <stop stop-color="{{color.light}}"/>
      <stop offset="1" stop-color="{{color.dark}}"/>
    </linearGradient>
  </defs>
  <g transform="translate({{spec.profile.padding.x}}, {{spec.profile.padding.y}})" data-cprs-plot="true">
    <text x="{{titleX}}" y="{{titleY}}" text-anchor="middle" font-size="16" font-weight="600" fill="#334155">{{title}}</text>
    {{! ===================== T axis numbers (even axis) and the column headings ===================== }}
    {{#each ticks as |tick|}}
      <text x="{{tick.x}}" y="{{../headY}}" text-anchor="middle" font-size="12" font-weight="{{#if tick.fifty}}600{{else}}400{{/if}}" fill="{{#if tick.fifty}}#64748B{{else}}#94A3B8{{/if}}">{{tick.value}}</text>
    {{/each}}
    {{#if fifty.label}}
      <text x="{{fifty.x}}" y="{{headY}}" text-anchor="middle" font-size="12" font-weight="600" fill="#64748B">50</text>
    {{/if}}
    {{#each headings as |heading|}}
      <text x="{{heading.x}}" y="{{../headY}}" text-anchor="middle" font-size="12" font-weight="400" fill="#94A3B8">{{heading.text}}</text>
    {{/each}}
    {{! ===================== Gridlines: dashed per tick, solid axis start ===================== }}
    {{#each ticks as |tick|}}
      {{#if @first}}
        <line x1="{{tick.x}}" y1="{{../gridTop}}" x2="{{tick.x}}" y2="{{../gridBottom}}" stroke="#CBD5E1" stroke-width="1"/>
      {{else}}
        <line x1="{{tick.x}}" y1="{{../gridTop}}" x2="{{tick.x}}" y2="{{../gridBottom}}" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="6 6" stroke-linecap="round"/>
      {{/if}}
    {{/each}}
    {{! ===================== One row per score, in the brief's order ===================== }}
    {{#each items as |item|}}
      <g data-cprs-score="{{item.label}}">
        <text x="{{../nameRight}}" y="{{item.baseline}}" dy=".35em" text-anchor="start" font-size="13" font-weight="400" fill="#334155">{{item.label}}</text>
        <g transform="translate({{../bar.x}}, {{item.top}})">
          {{bar ../bar.width ../bar.height (object tl=0 bl=0 tr=2 br=2) (toRad 0) fill=../color.track fill-opacity=0.5}}
          {{#if item.width}}{{bar item.width ../bar.height (object tl=0 bl=0 tr=item.radius br=item.radius) (toRad 0) fill="url(#cprs-bar)"}}{{/if}}
        </g>
        <text x="{{item.tX}}" y="{{item.baseline}}" dy=".35em" text-anchor="{{item.tAnchor}}" direction="ltr" font-size="13" font-weight="600" fill="{{item.tFill}}">{{item.t}}</text>
        {{#each item.values as |cell|}}
          <text x="{{cell.x}}" y="{{item.baseline}}" dy=".35em" text-anchor="middle" direction="ltr" font-size="14" font-weight="600" fill="{{../../color.dark}}">{{cell.value}}</text>
        {{/each}}
      </g>
    {{/each}}
    {{! ===================== The one line at T 50, over the bars ===================== }}
    <line x1="{{fifty.x}}" y1="{{gridTop}}" x2="{{fifty.x}}" y2="{{gridBottom}}" stroke="{{color.line}}" stroke-width="1" stroke-opacity="0.7"/>
  </g>
  {{else}}
  {{! ===================== No result (all-or-nothing), centred on the page ===================== }}
  <g transform="translate({{math (math spec.profile.padding.x '+' box.x) '-' 250}}, 257.5)">
    <rect x="0" y="0" width="500" height="199" rx="12" fill="#F8FAFC" stroke="#E2E8F0"/>
    <circle cx="250" cy="60.5" r="17" fill="none" stroke="#64748B" stroke-width="2"/>
    <line x1="250" y1="51.5" x2="250" y2="63.5" stroke="#64748B" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="250" cy="70" r="1.6" fill="#64748B"/>
    <text x="250" y="124.5" text-anchor="middle" font-size="17" font-weight="600" fill="#1E293B">نمره تولید نشد</text>
  </g>
  {{/if}}
{{/layout}}
