{{#> layout}}

  <g transform="translate({{spec.profile.padding.x}}, {{spec.profile.padding.y}})">
    {{! ===================== Type code and its title (MBTI9A) ===================== }}
    <g>
        <rect x="{{code.x}}" y="0" width="{{code.width}}" height="60" rx="8" fill="#F0FDFA" />
        <text x="{{code.centerX}}" y="16" dy=".7em" font-size="40" font-weight="800" fill="#0D9488" text-anchor="middle" direction="ltr" unicode-bidi="isolate">{{report.mark}}</text>
        <text x="{{code.centerX}}" y="72" dy="1em" font-size="16" font-weight="400" fill="#64748B" text-anchor="middle">{{report.fr}}</text>
    </g>

    {{! ===================== Framed rows: tile · two half-bars · tile (MBTI9A) ===================== }}
    <g transform="translate(0, 135)">
    <rect x="0" y="0" width="590" height="486" rx="20" fill="none" stroke="#E2E8F0" stroke-width="1" />
        <g transform="translate(0, 48)">
            {{#each items as |item index|}}
            <g transform="translate(132, {{math index '*' 114}})">
                <g>
                    <rect x="0" y="0" width="36" height="36" rx="4" fill="{{item.[0].colors.box}}" />
                    <text x="18" y="18" dy=".35em" font-size="24" font-weight="700" fill="{{item.[0].colors.letter}}" text-anchor="middle">{{item.[0].eng}}</text>
                    <text x="18" y="44" dy=".8em" font-size="13" font-weight="400" fill="{{item.[0].colors.accent}}" text-anchor="middle">{{item.[0].mark}}</text>
                    <text x="-12" y="0" dy=".8em" font-size="16" font-weight="600" fill="#475569" text-anchor="start">{{item.[0].percentage}}</text>
                    <text x="-12" y="18" dy=".8em" font-size="16" font-weight="400" fill="#475569" text-anchor="start">{{item.[0].fr}}</text>
                </g>
                {{#each item.[0].blocks as |b|}}
                    <rect x="{{b.x}}" y="0" width="12" height="36" rx="4" fill="{{@root.track}}" />
                    {{#if b.fill}}<rect x="{{b.fillX}}" y="0" width="{{b.fill}}" height="36" rx="{{b.radius}}" fill="{{item.[0].colors.accent}}" />{{/if}}
                {{/each}}
                {{#each item.[1].blocks as |b|}}
                    <rect x="{{b.x}}" y="0" width="12" height="36" rx="4" fill="{{@root.track}}" />
                    {{#if b.fill}}<rect x="{{b.fillX}}" y="0" width="{{b.fill}}" height="36" rx="{{b.radius}}" fill="{{item.[1].colors.accent}}" />{{/if}}
                {{/each}}
                <g transform="translate(290, 0)">
                    <rect x="0" y="0" width="36" height="36" rx="4" fill="{{item.[1].colors.box}}" />
                    <text x="18" y="18" dy=".35em" font-size="24" font-weight="700" fill="{{item.[1].colors.letter}}" text-anchor="middle">{{item.[1].eng}}</text>
                    <text x="18" y="44" dy=".8em" font-size="13" font-weight="400" fill="{{item.[1].colors.accent}}" text-anchor="middle">{{item.[1].mark}}</text>
                    <text x="48" y="0" dy=".8em" font-size="16" font-weight="600" fill="#475569" text-anchor="end">{{item.[1].percentage}}</text>
                    <text x="48" y="18" dy=".8em" font-size="16" font-weight="400" fill="#475569" text-anchor="end">{{item.[1].fr}}</text>
                </g>
            </g>
            {{/each}}
        </g>
    </g>
  </g>

{{/layout}}
