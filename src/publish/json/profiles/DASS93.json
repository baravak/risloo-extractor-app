          "زیاد"
        ]
      },
      "user_answered": "4"
    },
    {
      "type": "text",
      "text": "فکر می‌کنم بسیار حساس و زودرنج هستم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
