{{#> layout}}
  {{! layout supplies the canvas inset; this is the profile's declared inset. }}
  <g transform="translate({{spec.profile.padding.x}}, {{spec.profile.padding.y}})">
  {{#if valid}}
    {{#each styles as |item|}}
      <line x1="{{item.left}}" y1="{{item.y}}" x2="{{item.right}}" y2="{{item.y}}" stroke="#CBD5E1" stroke-width="2"/>
      <line x1="{{item.left}}" y1="{{math item.y '-' 5}}" x2="{{item.left}}" y2="{{math item.y '+' 5}}" stroke="#94A3B8"/>
      <line x1="{{item.right}}" y1="{{math item.y '-' 5}}" x2="{{item.right}}" y2="{{math item.y '+' 5}}" stroke="#94A3B8"/>
      <text x="792.5" y="{{math item.y '+' 5}}" text-anchor="start" font-size="15" font-weight="600" fill="#334155">{{item.title}}</text>
      <text x="{{item.left}}" y="{{math item.y '+' 24}}" text-anchor="middle" direction="ltr" font-size="12" fill="#64748B">{{item.min}}</text>
      <text x="{{item.right}}" y="{{math item.y '+' 24}}" text-anchor="middle" direction="ltr" font-size="12" fill="#64748B">{{item.max}}</text>
      <circle cx="{{item.x}}" cy="{{item.y}}" r="6" fill="#334155" stroke="white" stroke-width="2"/>
      <text x="{{item.x}}" y="{{math item.y '-' 20}}" text-anchor="middle" direction="ltr" font-size="18" font-weight="600" fill="#334155">{{item.mark}}</text>
    {{/each}}
  {{else}}
    {{! Same approved no-score component, centred in the new envelope. }}
    <rect x="150" y="26.5" width="500" height="171" rx="12" fill="#F8FAFC" stroke="#E2E8F0"/>
    <circle cx="400" cy="77" r="17" fill="none" stroke="#64748B" stroke-width="2"/>
    <line x1="400" y1="68" x2="400" y2="80" stroke="#64748B" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="400" cy="86.5" r="1.6" fill="#64748B"/>
    <text x="400" y="143" text-anchor="middle" font-size="16" font-weight="600" fill="#1E293B">نمره تولید نشد: پاسخ‌نامه کامل یا معتبر نبود.</text>
  {{/if}}
  </g>
{{/layout}}
