        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "1"
    },
    {
      "type": "text",
      "text": "احساس می‌کنم که هر لحظه ممکن است دچار ترس و وحشت شوم.",
