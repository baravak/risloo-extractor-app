{{#> layout}}

  {{#if valid}}
  <defs>
    {{! PRPS93 gradient geometry; one palette for all three scales (no levels). }}
    <linearGradient id="caars-gauge-gradient" x1="70" y1="-69.2295" x2="-58.8284" y2="125.6012" gradientUnits="userSpaceOnUse">
      <stop stop-color="{{theme.accent}}"/>
      <stop offset="0.5" stop-color="{{theme.primary}}"/>
      <stop offset="1" stop-color="{{theme.primary}}"/>
    </linearGradient>
    <path id="caars-gauge-track" d="{{trackPath}}"/>
    <clipPath id="caars-gauge-clip"><use href="#caars-gauge-track"/></clipPath>
  </defs>
  {{/if}}

  <g transform="translate({{spec.profile.padding.x}}, {{spec.profile.padding.y}})">

  {{#if valid}}

    {{! ===================== Three separate gauges, each filled by its own percent ===================== }}
    {{#each scales as |item|}}
      <g transform="translate({{item.x}}, 0)" data-caars-scale="{{item.key}}">
        <g transform="translate(70.5, 70)">
          <use href="#caars-gauge-track" fill="{{../theme.track}}"/>
          {{#if item.fillPath}}
            <path d="{{item.fillPath}}" fill="url(#caars-gauge-gradient)" clip-path="url(#caars-gauge-clip)"/>
          {{/if}}
          <text x="0.5" y="-4.16" text-anchor="middle" direction="ltr" unicode-bidi="embed" font-size="24" font-weight="600" fill="{{../theme.primary}}">٪ {{item.pct}}</text>
          <text x="0.5" y="21.275" text-anchor="middle" direction="rtl" font-size="15" font-weight="500" fill="#64748B">{{item.mark}} از {{item.max}}</text>
          <text x="-59" y="-7.51" text-anchor="middle" direction="ltr" unicode-bidi="embed" font-size="14" font-weight="500" fill="#64748B">٪ 100</text>
          <text x="-11" y="-57.01" text-anchor="middle" direction="ltr" font-size="14" font-weight="500" fill="#64748B">0</text>
        </g>
        <text x="70.5" y="172.06" text-anchor="middle" font-size="16" font-weight="500" fill="{{../theme.primary}}">{{item.title}}</text>
      </g>
    {{/each}}

    {{! ===================== Limitations and reference cut-off ===================== }}
    {{! Exactly the brief's two text blocks, no interpretation text; read by the authorised specialist. }}
    <g transform="translate(0, {{textTop}})">
      <rect x="0.5" y="0.5" width="862" height="313" rx="8" fill="#F8FAFC" stroke="#E2E8F0"/>

      <text x="843" y="30" text-anchor="start" font-size="15" font-weight="600" fill="#1E293B">عدم قطعیت و محدودیت</text>
      <circle cx="840" cy="53.5" r="2" fill="#334155"/>
      <text x="831" y="58" text-anchor="start" font-size="13.5" fill="#334155">این ابزار غربال است، نه تشخیص.</text>
      <circle cx="840" cy="77.5" r="2" fill="#334155"/>
      <text x="831" y="82" text-anchor="start" font-size="13.5" fill="#334155">برای این نسخه هنجار ایرانی و برش قابل محاسبه وجود ندارد.</text>
      <circle cx="840" cy="101.5" r="2" fill="#334155"/>
      <text x="831" y="106" text-anchor="start" font-size="13.5" fill="#334155">نمرهٔ بالا ممکن است از افسردگی یا اضطراب هم بیاید.</text>
      <circle cx="840" cy="125.5" r="2" fill="#334155"/>
      <text x="831" y="130" text-anchor="start" font-size="13.5" fill="#334155">آزمون تصمیم‌یار است، نه تصمیم‌گیر قطعی.</text>

      <text x="843" y="166" text-anchor="start" font-size="15" font-weight="600" fill="#1E293B">نقطهٔ برش مرجع</text>
      {{! "T ≥ 65" is its own left-to-right text: inside a right-to-left run it reorders to "65 ≥ T". }}
      <text x="843" y="192" direction="ltr" text-anchor="end" font-size="13" font-weight="600" fill="#334155">T ≥ 65</text>
      <text x="790" y="192" text-anchor="start" font-size="13" fill="#334155">— حساسیت 59٪، ویژگی 92٪</text>
      <text x="843" y="216" direction="ltr" text-anchor="end" font-size="13" font-weight="600" fill="#334155">T ≥ 55</text>
      <text x="790" y="216" text-anchor="start" font-size="13" fill="#334155">— حساسیت 89٪، ویژگی 68٪</text>
      <text x="843" y="242" text-anchor="start" font-size="13" fill="#334155">منبع: مطالعهٔ روایی ملاکیِ یک ترجمهٔ فارسیِ دیگر از همین فرم، 1393.</text>
      <text x="843" y="266" text-anchor="start" font-size="13" fill="#334155">جامعه: 100 والدِ کودکانِ مبتلا به ADHD؛ ملاک بیرونی: مصاحبهٔ روان‌پزشکی بر پایهٔ ملاک‌های یوتا.</text>
      <text x="843" y="294" text-anchor="start" font-size="13" font-weight="600" fill="#334155">این دو عدد روی مقیاس T تعریف شده‌اند و با نمره‌های خامِ این نسخه قابل مقایسه نیستند.</text>
    </g>

  {{else}}

    {{! ===================== Alert: no score (all-or-nothing) ===================== }}
    {{! Neutral, not the system-error look; no gauge, number or zero is drawn. }}
    <rect x="181.5" y="230.5" width="500" height="160" rx="12" fill="#F8FAFC" stroke="#E2E8F0"/>
    <circle cx="431.5" cy="285" r="17" fill="none" stroke="#64748B" stroke-width="2"/>
    <line x1="431.5" y1="276" x2="431.5" y2="288" stroke="#64748B" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="431.5" cy="294.5" r="1.6" fill="#64748B"/>
    <text x="431.5" y="342" text-anchor="middle" font-size="17" font-weight="600" fill="#1E293B">نمره تولید نشد</text>

  {{/if}}

  </g>

{{/layout}}
