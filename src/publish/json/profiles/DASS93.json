  "description": "## دستور اجرای آزمون\n\nخواهشمند است از طریق از جملات زیر را به دقت بخوانید و با علامت × مشخص کنید که هر جمله تا چه اندازه در مورد شما صدق می‌کند. توجه داشته باشید که جمله درست و غلطی وجود ندارد. وقت زیادی روی هر چون به صرف نکنید.",
  "items": [
    {
      "type": "text",
      "text": "برایم مشکل است آرام بگیرم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "4"
    },
    {
      "type": "text",
      "text": "متوجه شده‌ام دهانم خشک می‌شود.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "1"
    },
    {
      "type": "text",
      "text": "فکر نمی‌کنم بتوانم هیچ نوع احساس خوبی را تجربه کنم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "4"
    },
    {
      "type": "text",
      "text": "تنفس کردن برایم مشکل است.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "4"
    },
    {
      "type": "text",
      "text": "برایم سخت است در انجام کار پیشقدم شوم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "3"
    },
    {
      "type": "text",
      "text": "به موقعیت‌هایم به طور افراطی واکنش نشان می‌دهم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "2"
    },
    {
      "type": "text",
      "text": "در بدنم احساس لرزش می‌کنم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "4"
    },
    {
      "type": "text",
      "text": "احساس می‌کنم انرژی روانی زیادی مصرف می‌کنم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "4"
    },
    {
      "type": "text",
      "text": "نگرانم که مبادا در بعضی موقعیت‌ها دچار ترس شوم یا به کار احمقانه‌ای دست بزنم.",
      "answer": {
        "type": "optional",
        "options": [
          "اصلاً",
          "کم",
          "متوسط",
          "زیاد"
        ]
      },
      "user_answered": "4"
    },
    {
      "type": "text",
      "text": "احساس می‌کنم چیزی ندارم که منتظرش باشم.",
